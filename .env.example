# ============================================================
# Meditrack HMS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# All sensitive credentials MUST live here, never in code.

APP_NAME="Meditrack HMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ASSET_URL=http://localhost:8000

# --- Octane (Swoole for production performance) ---
OCTANE_SERVER=swoole
OCTANE_HTTPS=false
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=8
OCTANE_MAX_REQUESTS=1000

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meditrack
DB_USERNAME=meditrack
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# PostgreSQL alternative:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=meditrack

# --- Redis (cache, sessions, queues, rate limiting) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2
REDIS_THROTTLE_DB=3

# --- Cache / Session / Queue ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@meditrack.ea"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=null
MAIL_USERNAME=null
MAIL_PASSWORD=null

# --- Fortify (Auth) ---
FORTIFY_VIEW_PATH="resources/views"
FORTIFY_HOME="/dashboard"
FORTIFY_LIMIT_LOGIN=5
FORTIFY_LIMIT_REGISTER=3
FORTIFY_LIMIT_RESET=3
FORTIFY_LIMIT_2FA=5

# --- Sanctum ---
SANCTUM_TOKEN_EXPIRATION=525600
SANCTUM_MIDDLWARE_AUTH_GUARD=web

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://meditrack.ea
CORS_ALLOWED_PATHS=/*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=*
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=true

# ============================================================
# East African Integration Credentials
# ============================================================

# --- Africa's Talking (SMS gateway — covers UG/KE/TZ/RW) ---
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AFRICAS_TALKING_SENDER_ID=MEDITRACK
AFRICAS_TALKING_SHORTCODE=12345
AFRICAS_TALKING_SANDBOX=true

# --- MTN MoMo (Uganda collections + disbursements) ---
MTN_MOMO_API_USER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MTN_MOMO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MTN_MOMO_SUBSCRIPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_TARGET_ENVIRONMENT=mtncameroon
MTN_MOMO_COLLECTION_PRIMARY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MTN_MOMO_DISBURSEMENT_PRIMARY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MTN_MOMO_CALLBACK_URL=https://meditrack.ea/api/v1/payments/mtn/callback

# --- Airtel Money (Uganda collections) ---
AIRTEL_MONEY_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AIRTEL_MONEY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTEL_MONEY_GRANT_TYPE=client_credentials
AIRTEL_MONEY_ENVIRONMENT=sandbox
AIRTEL_MONEY_CALLBACK_URL=https://meditrack.ea/api/v1/payments/airtel/callback

# --- M-Pesa (Kenya Safaricom) ---
MPESA_CONSUMER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MPESA_CONSUMER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MPESA_PASSKEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://meditrack.ea/api/v1/payments/mpesa/callback

# --- Twilio (Emergency voice calls) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+256700000000
TWILIO_EMERGENCY_GROUP=+256700000001,+256700000002

# --- NIRA (Uganda National ID verification) ---
NIRA_API_URL=https://api.nira.go.ug/v1
NIRA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIRA_CLIENT_ID=meditrack
NIRA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIRA_TIMEOUT=30

# --- NIIMS / Huduma Namb (Kenya national ID) ---
NIIMS_API_URL=https://api.hudumanamba.go.ke/v1
NIIMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- NIDA (Tanzania national ID) ---
NIDA_API_URL=https://api.nida.go.tz/v1
NIDA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- NIDA Rwanda ---
NIDA_RWANDA_API_URL=https://api.nida.gov.rw/v1
NIDA_RWANDA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Insurance Providers API Credentials ---
INSURANCE_UAP_API_URL=https://api.uapoldmutual.com/v1
INSURANCE_UAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSURANCE_JUBILEE_API_URL=https://api.jubileeinsurance.com/v1
INSURANCE_JUBILEE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSURANCE_ICEA_API_URL=https://api.icealion.com/v1
INSURANCE_ICEA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSURANCE_BRITAM_API_URL=https://api.britam.com/v1
INSURANCE_BRITAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSURANCE_SANLAM_API_URL=https://api.sanlam.com/v1
INSURANCE_SANLAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- NHIF Kenya ---
NHIF_KENYA_API_URL=https://api.nhif.or.ke/v1
NHIF_KENYA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- NHIF Tanzania ---
NHIF_TANZANIA_API_URL=https://api.nhif.go.tz/v1
NHIF_TANZANIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- RSSB Rwanda (Social Security / Health Insurance) ---
RSSB_RWANDA_API_URL=https://api.rssb.rw/v1
RSSB_RWANDA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- NMS Uganda (National Medical Stores — pharmacy supply chain) ---
NMS_API_URL=https://api.nms.go.ug/v1
NMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NMS_ACCOUNT_NUMBER=xxxxxxxxxxxx

# --- KEMSA Kenya (Kenya Medical Supplies Authority) ---
KEMSA_API_URL=https://api.kemsa.co.ke/v1
KEMSA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MSD Tanzania (Medical Stores Department) ---
MSD_API_URL=https://api.msd.go.tz/v1
MSD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LIS (Laboratory Information System — HL7/FHIR) ---
LIS_API_URL=https://lis.meditrack.ea/api
LIS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIS_HL7_PORT=2575
LIS_FHIR_BASE=https://lis.meditrack.ea/fhir

# --- GPS Tracking (ambulance fleet) ---
GPS_PROVIDER=ontrack
GPS_API_URL=https://api.ontrack.co.ug/v1
GPS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GPS_POLL_INTERVAL=30

# --- Scribe API Documentation ---
SCRIBE_API_DOMAIN=localhost:8000
SCRIBE_TYPE=laravel
SCRIBE_BASE_PATH=api/v1
SCRIBE_TITLE="Meditrack HMS API"
SCRIBE_DESCRIPTION="Hospital Management System API for East Africa"
SCRIBE_VERSION=1.0.0

# --- Horizon Dashboard ---
HORIZON_DASHBOARD_PATH=horizon
HORIZON_AUTH=true

# --- Encryption key for PII column encryption ---
# Leave null to use APP_KEY; set explicitly for separate key rotation
PII_ENCRYPTION_KEY=

# --- Feature flags ---
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_MOBILE_MONEY=true
ENABLE_INSURANCE_INTEGRATION=true
ENABLE_ID_VERIFICATION=true
ENABLE_LIS_INTEGRATION=true
ENABLE_PHARMACY_SUPPLY_CHAIN=true
ENABLE_AMBULANCE_GPS=true
ENABLE_TWILIO_EMERGENCY=true
